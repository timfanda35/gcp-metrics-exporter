# Copy to .env.e2e and fill in, then:
#   docker compose --env-file .env.e2e -f docker-compose.e2e.yaml up -d --build
#
# Host path to ADC / Service Account JSON, e.g.
#   ~/.config/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
PROJECT_A=my-project-a
PROJECT_B=my-project-b
# Optional: default impersonation target for the exporter.
IMPERSONATE_SA=
